# Copy this file to .env.local and fill in your real values.

NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com

# Supabase (login + database). See SETUP.md. Use the "anon public" key only, never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AdSense (get these after your site is approved)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_TOP=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=0000000000

# Adsterra banner keys (from your Adsterra dashboard, "Banner" ad units)
NEXT_PUBLIC_ADSTERRA_KEY_728X90=
NEXT_PUBLIC_ADSTERRA_KEY_300X250=
# Only change this if your Adsterra invoke.js code uses a different domain
NEXT_PUBLIC_ADSTERRA_DOMAIN=www.highperformanceformat.com

# Extra ads.txt lines (separate multiple lines with |), e.g. the line Adsterra gives you
ADS_TXT_EXTRA=
